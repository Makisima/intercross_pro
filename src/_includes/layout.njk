  <style>
        /* 1. Показываем текст и кнопки на баннерах */
        .banners-big .box.item .text,
        .banners-big .box.item .text .inner,
        .banners-big .box.item .title,
        .banners-big .box.item .btn,
        .banners-big .box.item .text-block {
            opacity: 1 !important;
            visibility: visible !important;
            transform: none !important;
        }

        /* 2. Задаем высоту 4-м плиткам производства и делаем ховер */
        .float-banners .item {
            position: relative;
            padding-bottom: 85%; /* Пропорции плитки */
            overflow: hidden;
        }
        .float-banners .item .img_block,
        .float-banners .item .dark_block_animate {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-size: cover;
            background-position: center;
        }
        .float-banners .item .wrap_tizer {
            position: absolute;
            bottom: 0; left: 0; width: 100%;
            opacity: 0;
            transition: opacity 0.3s ease;
            background: rgba(0, 0, 0, 0.6); /* Затемнение при наведении */
            color: #fff;
            padding: 20px;
            box-sizing: border-box;
        }
        .float-banners .item:hover .wrap_tizer {
            opacity: 1;
        }
        .float-banners .item .wrap_tizer a,
        .float-banners .item .wrap_tizer span {
            color: #fff;
            text-decoration: none;
            font-size: 16px;
            font-weight: 500;
        }

        /* 3. Оживляем выпадающее меню (ховер) */
        .table-menu td.menu-item {
            position: relative;
        }
        .table-menu .dropdown-menu {
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 1000;
            display: none !important;
            background: #fff;
            min-width: 220px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
            padding: 10px 0;
            list-style: none;
            margin: 0;
        }
        .table-menu .menu-item:hover > .dropdown-menu {
            display: block !important;
        }
        .table-menu .dropdown-menu li a {
            display: block;
            padding: 10px 20px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
            transition: background 0.2s;
        }
        .table-menu .dropdown-menu li a:hover {
            background: #f5f5f5;
        }
    </style>
</head>
