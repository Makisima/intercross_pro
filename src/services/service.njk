---
layout: layout.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: "/services/{{ service.slug }}/index.html"
eleventyComputed:
  title: "{{ service.title }} — АО «Интеркросс»"
  description: "{{ service.intro }}"
bodyClass: "header_nopacity header_fill_colored side_left all_title_2 mfixed_Y mfixed_view_always fill_bg_n mheader-v1 footer-v3 header-v1 title-v1 with_phones"
---
<div class="body">
	<div class="body_media"></div>
	<div role="main" class="main banner-auto">
		<div class="container">
			<div class="maxwidth-theme">

				<div class="breadcrumbs">
					<ul class="breadcrumb">
						<li><a href="/">Главная</a></li>
						<li><a href="/services/">Производство</a></li>
						<li><span>{{ service.title }}</span></li>
					</ul>
				</div>

				<h1 id="pagetitle">{{ service.title }}</h1>

				{% if service.intro %}
				<div class="intro-text" style="font-size: 16px; color: #333; margin: 20px 0 30px; line-height: 1.6;">
					{{ service.intro }}
				</div>
				{% endif %}

				{% if service.content %}
				<div class="content" style="margin-bottom: 30px;">
					{{ service.content | safe }}
				</div>
				{% endif %}

				{% if service.gallery | length %}
				<h5 style="margin-top: 40px; margin-bottom: 15px;">Фотогалерея</h5>
				<div class="service-gallery" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 40px;">
					{% for img in service.gallery %}
					<a href="{{ img.full }}" target="_blank" style="display: block; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 4px; border: 1px solid #eee;">
						<img src="{{ img.thumb }}" alt="{{ service.title }}" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
					</a>
					{% endfor %}
				</div>
				{% endif %}

				<div class="row" style="margin-top: 40px; align-items: center;">
					<div class="col-md-6">
						<a href="/services/" class="btn btn-default">← Назад к списку</a>
					</div>
					<div class="col-md-6" style="text-align: right;">
						<a href="/contacts/" class="btn btn-default">Задать вопрос</a>
					</div>
				</div>

			</div>
		</div>
	</div>
</div>