---
layout: layout.njk
title: "Новости — АО «Интеркросс»"
description: "Новости и события компании АО «Интеркросс»."
bodyClass: "header_nopacity header_fill_colored side_left all_title_2 mfixed_Y mfixed_view_always fill_bg_n mheader-v1 footer-v3 header-v1 title-v1 with_phones"
---
<div class="body">
	<div class="body_media"></div>
	<div role="main" class="main banner-auto">
		<div class="container">
			<div class="maxwidth-theme">

				<div class="breadcrumbs">
					<ul class="breadcrumb">
						<li><a href="/">Главная</a></li>
						<li><span>Новости</span></li>
					</ul>
				</div>

				<h1 id="pagetitle">Новости</h1>

				<div class="row">
					{% for n in news %}
					<div class="col-md-4 col-sm-6">
						<div class="item shadow slice-item wdate">
							<div class="image shine">
								<a href="/info/news/{{ n.slug }}/">
									{% if n.image %}
									<img src="{{ n.image }}" alt="{{ n.title }}" title="{{ n.title }}" class="img-responsive" />
									{% else %}
									<img src="/bitrix/templates/aspro-allcorp2/images/noimage_sections.png" alt="{{ n.title }}" class="img-responsive" />
									{% endif %}
								</a>
							</div>
							<div class="body-info">
								<div class="sticker-block">Компания</div>
								<div class="title">
									<a href="/info/news/{{ n.slug }}/" class="dark-color">{{ n.title }}</a>
								</div>
								{% if n.date %}
								<div class="period">
									<span class="date">{{ n.date }}</span>
								</div>
								{% endif %}
							</div>
						</div>
					</div>
					{% endfor %}
				</div>

			</div>
		</div>
	</div>
</div>