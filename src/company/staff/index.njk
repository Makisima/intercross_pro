<style>
	.staff-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin-top: 20px;
		margin-bottom: 30px;
	}
	.staff-card {
		background: #fff;
		border: 1px solid #eee;
		border-radius: 4px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: box-shadow 0.3s;
	}
	.staff-card:hover {
		box-shadow: 0 5px 15px rgba(0,0,0,0.1);
	}
	.staff-card .staff-img {
		width: 100%;
		height: 250px;
		object-fit: cover;
		object-position: top center;
		background: #f9f9f9;
	}
	.staff-card .staff-body {
		padding: 20px;
		text-align: center;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.staff-card .staff-name {
		font-size: 16px;
		font-weight: 600;
		color: #222;
		margin-bottom: 5px;
		line-height: 1.3;
	}
	.staff-card .staff-post {
		font-size: 13px;
		color: #777;
		margin-bottom: 15px;
		flex-grow: 1;
	}
	.staff-card .staff-contact {
		font-size: 13px;
		margin-bottom: 5px;
	}
	.staff-card .staff-contact a {
		color: #034EA2;
		text-decoration: none;
	}
	.staff-card .staff-contact a:hover {
		text-decoration: underline;
	}
	@media (max-width: 991px) {
		.staff-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 575px) {
		.staff-grid { grid-template-columns: 1fr; }
	}
</style>

